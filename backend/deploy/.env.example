# Multi-tenant environment configuration
# Used exclusively with docker-compose.multi-tenant.yml

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=phawmdb_mt           # separate DB from single-tenant phawmdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- App ---
RESEND_API_KEY=
IS_DEMO=TRUE
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# --- Storage ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://rustfs-mt:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET_NAME=workbench
S3_REGION=us-east-1
